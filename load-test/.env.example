# Never point this file at the production project (magzmotron-5ae93).
FIREBASE_PROJECT_ID=isdp-loadtest
FIREBASE_API_KEY=replace-with-the-staging-web-api-key
FIREBASE_APP_ID=replace-with-the-staging-web-app-id
FIREBASE_AUTH_DOMAIN=isdp-loadtest.firebaseapp.com
FIREBASE_STORAGE_BUCKET=isdp-loadtest.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=replace-with-the-staging-sender-id

# Admin scripts (seed and cleanup) use Application Default Credentials.
# Use an absolute path to a service-account JSON belonging to the staging project.
GOOGLE_APPLICATION_CREDENTIALS=C:\absolute\path\to\staging-service-account.json

LOAD_TEST_PASSWORD=LoadTest-Only-Change-Me-2026!
LOAD_TEST_RUN_ID=baseline-500

# Required only when the staging project ID does not contain test/staging/load/demo.
# LOAD_TEST_ALLOW_PROJECT=exact-staging-project-id

# Emulator alternative. The Admin SDK variables intentionally omit http://.
# USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
